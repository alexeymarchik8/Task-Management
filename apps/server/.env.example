# HTTP-порт сервера
PORT=3000

# Origin клиента, которому разрешён CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Строка подключения к PostgreSQL (Prisma), формат:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/task_management

# Секрет для подписи JWT — задайте случайную строку в реальном окружении
JWT_SECRET=change-me
